Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Enabled: true
    - Class: rviz_default_plugins/Axes
      Name: Origin (Home)
      Length: 1
      Radius: 0.05
      Enabled: true
    - Class: rviz_default_plugins/Pose
      Name: UAV Pose
      Topic:
        Value: /mavros/local_position/pose
      Shape: Arrow
      Color: 255; 25; 0
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Flight Path
      Topic:
        Value: /mission/flight_path
      Color: 0; 170; 255
      Line Width: 0.05
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 40
      Focal Point:
        X: 0
        Y: 0
        Z: 5
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
